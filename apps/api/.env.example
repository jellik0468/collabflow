PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabflow
NODE_ENV=development

# Local email preview. Messages are private JSON files under apps/api/.local-mail.
# MAIL_MODE=file
# MAIL_DIRECTORY=.local-mail

# SMTP email provider for production
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# When deployed behind a reverse proxy, set its actual address/range.
# TRUST_PROXY=loopback
